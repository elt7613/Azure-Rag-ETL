# Configuration for the Northwind Knowledge Assistant.
#
# Every setting the system reads is listed here, in the order it is declared in
# `src/rag/config.py` -- which is the only module that reads the environment.
# Generated by `python scripts/gen_env.py`; edit the Settings class, not this
# file.
#
# Values marked REQUIRED have no default: the app will not start without them.


# ---------------------------------------------------------------------
# Document source
# ---------------------------------------------------------------------
# Where documents come from: 'local' (LOCAL_SOURCE_DIR) or 'blob'.
DOC_SOURCE=local
# Root folder scanned when DOC_SOURCE=local, one subfolder per department. Defaults to the bundled source_data/; point it at your own documents.
LOCAL_SOURCE_DIR=source_data
# The department list; must match the folder names under LOCAL_SOURCE_DIR (case-insensitive). Drives what is monitored, ingested, labelled and retrievable. Adding one is an env edit plus a folder.
DEPARTMENTS=["HR","finance","IT","legal","sales"]
# Glob patterns a file must match to be ingested.
INCLUDED_PATTERNS=["**/*.pdf","**/*.docx","**/*.xlsx","**/*.pptx","**/*.csv","**/*.tsv","**/*.txt","**/*.md","**/*.html","**/*.htm","**/*.json","**/*.png","**/*.jpg","**/*.jpeg","**/*.tiff","**/*.bmp"]
# Optional {"HR": "people-ops"} map, when a department's folder is not named after it. Absent departments use their own name.
DEPARTMENT_SOURCES={}
# What to do with a document whose folder matches no department: 'skip' or 'ingest'.
UNKNOWN_DEPARTMENT_POLICY=skip

# ---------------------------------------------------------------------
# Live monitoring
# ---------------------------------------------------------------------
# Full rescan interval in --live mode; a safety net for filesystem events the OS watcher drops.
LIVE_RESCAN_SECONDS=300
# How often the Blob source re-lists ETags to detect changes.
BLOB_POLL_SECONDS=60

# ---------------------------------------------------------------------
# Azure Blob Storage (used when DOC_SOURCE=blob)
# ---------------------------------------------------------------------
# Storage account name.
AZURE_STORAGE_ACCOUNT=
# Container holding the documents.
AZURE_STORAGE_CONTAINER=knowledge-base
# Account key. Either this pair or the connection string below.
AZURE_STORAGE_KEY=
# Full connection string; account and key are derived from it if those are blank.
AZURE_STORAGE_CONNECTION_STRING=
# Only ingest blobs under this prefix. Blank = the whole container.
AZURE_BLOB_PREFIX=

# ---------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------
# 'auto' routes per format and per document (local parsers, OCR for scanned PDFs). 'local' never calls Document Intelligence; 'azure' always does.
DOC_PARSER=auto
# Document Intelligence endpoint. Needed for scanned PDFs and images.
AZURE_DOCINT_ENDPOINT=
# Document Intelligence key.
AZURE_DOCINT_KEY=
# Below this many extractable characters per page a PDF is treated as scanned and sent to OCR. Corpus PDFs read 1,300-1,900; a scanned page reads 0.
SCANNED_PDF_CHAR_THRESHOLD=100
# Caption embedded figures with a vision call, making charts retrievable. Off by default: one call per image.
VISION_CAPTIONS_ENABLED=false

# ---------------------------------------------------------------------
# Azure OpenAI — embeddings and chat
# ---------------------------------------------------------------------
# REQUIRED. Azure OpenAI endpoint for embeddings and chat.
AZURE_OPENAI_ENDPOINT=
# REQUIRED. Azure OpenAI key.
AZURE_OPENAI_KEY=
# API version for embeddings.
AZURE_OPENAI_API_VERSION=2024-10-21
# REQUIRED. Embedding deployment name (not the model id).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Must match the embedding model and the search index's vector field.
EMBEDDING_DIMENSIONS=1536
# Texts per embedding request.
EMBEDDING_BATCH_SIZE=32
# Chat deployment name. Used for planning, answering, verification and extraction.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# Tracked separately from the embedding version: strict JSON-schema structured outputs need a newer preview track.
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview

# ---------------------------------------------------------------------
# Azure OpenAI — batch (bulk extraction backfill)
# ---------------------------------------------------------------------
# Blank = reuse the values above. Batch needs a 'globalbatch' or 'datazonebatch' deployment, which usually means a separate resource, since one account holds a single SKU per model.
AZURE_OPENAI_BATCH_ENDPOINT=
# Key for the batch resource.
AZURE_OPENAI_BATCH_KEY=
# Batch deployment name.
AZURE_OPENAI_BATCH_DEPLOYMENT=
# API version for the batch resource.
AZURE_OPENAI_BATCH_API_VERSION=

# ---------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------
# REQUIRED. Azure AI Search endpoint.
AZURE_SEARCH_ENDPOINT=
# REQUIRED. Admin key; the pipeline creates and writes the index.
AZURE_SEARCH_KEY=
# REQUIRED. Index name. Recreated if its field schema does not match.
AZURE_SEARCH_INDEX=
# Semantic configuration name used for cross-encoder reranking.
AZURE_SEARCH_SEMANTIC_CONFIG=default-semantic

# ---------------------------------------------------------------------
# CocoIndex incremental state
# ---------------------------------------------------------------------
# Filesystem path to CocoIndex's embedded LMDB state (what was processed, at what fingerprint).
COCOINDEX_DB=data/cocoindex

# ---------------------------------------------------------------------
# Neo4j knowledge graph
# ---------------------------------------------------------------------
# Bolt URI. Use bolt+s:// for TLS.
NEO4J_URI=bolt://localhost:7687
# Neo4j username.
NEO4J_USER=neo4j
# Neo4j password.
NEO4J_PASSWORD=
# Database name.
NEO4J_DATABASE=neo4j
# Write the graph at all. Off = vector-only; retrieval degrades rather than failing.
GRAPH_ENABLED=true

# ---------------------------------------------------------------------
# Relationship extraction
# ---------------------------------------------------------------------
# Extract entities and typed relations with an LLM. Off leaves only the deterministic Document/Section/Chunk structure.
GRAPH_EXTRACTION_ENABLED=true
# 'online' extracts during ingest (right for incremental changes); 'batch' uses the Azure OpenAI Batch API at half price for a bulk backfill.
GRAPH_EXTRACT_MODE=online
# Units shorter than this are skipped. Measured: at 40 this dropped a real 38-token account-lockout rule.
GRAPH_EXTRACT_MIN_TOKENS=30
# Minimum density of entity-bearing content (money, dates, durations, obligations) before a unit is worth an LLM call.
GRAPH_EXTRACT_MIN_SIGNAL=0.02
# Small units are packed into one call up to this budget, amortising the fixed prompt overhead.
GRAPH_EXTRACT_PACK_TOKENS=3000
# Concurrent extraction calls, with backoff on 429.
GRAPH_EXTRACT_CONCURRENCY=8
# Content-hash memo store. Re-ingesting unchanged text costs nothing.
EXTRACTION_CACHE_PATH=data/extraction_cache.db
# One row per document, holding what cross-document supersession resolution needs.
DOCUMENT_REGISTRY_PATH=data/document_registry.db
# Identical text appearing in at least this many documents is boilerplate: extracted once, not once per document.
BOILERPLATE_DOC_THRESHOLD=3
# Similarity above which two entity mentions are treated as the same entity.
ENTITY_MERGE_THRESHOLD=0.9

# ---------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------
# Chunks passed to the answer prompt for a single-part question. Grows with the number of sub-queries.
RETRIEVAL_TOP_K=8
# Candidates the vector side feeds into fusion. 50 because Azure's semantic ranker reranks the top 50 -- fewer and it has nothing to work with.
VECTOR_K=50
# Candidates fetched per query before fusion, and the ceiling on the context budget.
RERANK_TOP_K=20
# On the reranker's 0-4 scale. Below this the system abstains instead of answering.
SUFFICIENCY_THRESHOLD=1.6
# Cache answers. Partitioned by department scope; refusals are never cached.
QUERY_CACHE_ENABLED=true
# Cosine similarity for a semantic cache hit. Deliberately tight -- a loose threshold is how caches leak one scope's answer to another.
SEMANTIC_CACHE_THRESHOLD=0.93

# ---------------------------------------------------------------------
# API
# ---------------------------------------------------------------------
# Departments granted when the auth gateway supplies no scope. EMPTY IS THE SECURE DEFAULT: a request that establishes no identity reads nothing. Set only for a single-tenant demo.
API_DEFAULT_DEPARTMENTS=[]
# Cache entry lifetime. A cache with no TTL is a slow-motion correctness bug: policies change.
QUERY_CACHE_TTL_SECONDS=900
# Per-scope cache size before the oldest entries are evicted.
QUERY_CACHE_MAX_ENTRIES=512

# ---------------------------------------------------------------------
# Cost accounting (USD per 1M tokens, for reporting only)
# ---------------------------------------------------------------------
# Input token price, for the cost report only. Update if the model or tier changes.
COST_PER_1M_INPUT=0.4
# Price for prompt-cache hits, billed lower than fresh input.
COST_PER_1M_CACHED_INPUT=0.1
# Output token price. Note output is ~96% of the extraction bill.
COST_PER_1M_OUTPUT=1.6
# Embedding token price.
COST_PER_1M_EMBEDDING=0.02

# ---------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------
# Target prose chunk size before splitting.
CHUNK_TARGET_TOKENS=700
# Hard ceiling on a prose chunk.
CHUNK_MAX_TOKENS=900
# Overlap between consecutive prose chunks, so a split does not orphan a sentence.
CHUNK_OVERLAP_TOKENS=100
# tiktoken encoding used for every token count in the pipeline.
TOKENIZER_ENCODING=cl100k_base
